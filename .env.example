# ── Contact form (Resend) ──────────────────────────────
# Crée une clé sur https://resend.com → API Keys
RESEND_API_KEY=
# Adresse qui reçoit les demandes de contact
CONTACT_TO_EMAIL=contact@tyvlinguistic.com
# Expéditeur (doit être un domaine vérifié dans Resend ; sinon laisse la valeur par défaut)
CONTACT_FROM_EMAIL="TYV <onboarding@resend.dev>"

# Sans RESEND_API_KEY, le formulaire fonctionne quand même :
# la demande est loggée côté serveur au lieu d'être envoyée par email.

# ── Tracking & Analytics ───────────────────────────────
# Chaque outil ne s'active que si son ID est renseigné.
NEXT_PUBLIC_GTM_ID=          # Google Tag Manager — ex. GTM-XXXXXXX
NEXT_PUBLIC_GA_ID=           # Google Analytics 4 — ex. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=   # Meta Pixel — ex. 1234567890
NEXT_PUBLIC_CLARITY_ID=      # Microsoft Clarity — ex. abcdef1234

# ── Espace d’administration TYV (/admin) ──────────────────────
# Mot de passe remis à TYV pour modifier textes et photos.
# Défini dans Netlify (Site settings → Environment variables), jamais dans Git.
ADMIN_PASSWORD=
# Clé aléatoire servant à signer le cookie de session (32+ caractères).
# Génération : openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Sans ces deux variables, /admin affiche simplement « espace non activé ».
